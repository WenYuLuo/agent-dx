  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(adx_environment_create_responses_total, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(adx_environment_create_responses_total, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "adx_env",
        "label": "adx_env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(adx_environment_create_responses_total{cluster=~\"$cluster\"}, adx_env)",
          "refId": "adx_env"
        },
        "definition": "label_values(adx_environment_create_responses_total{cluster=~\"$cluster\"}, adx_env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
